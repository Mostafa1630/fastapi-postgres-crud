# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/blog

# JWT Secrets & Expiration
SECRET_KEY=generate_a_very_long_and_secure_random_secret_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security & CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Application Environment & Docs
DOCS_ENABLED=True
ENVIRONMENT=development
MAX_REQUEST_SIZE_BYTES=2097152

# First Admin Seed Setup
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@123456
